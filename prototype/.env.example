# Copy to .env and fill in, then load it before starting a server:
#   export $(grep -v '^#' .env | xargs)

# --- Base de dados --------------------------------------------------------
# Vazio  -> SQLite local em data/app.db  (desenvolvimento)
# postgres://... ou postgresql://...  -> Postgres  (produção)
DATABASE_URL=

# --- IA ------------------------------------------------------------------
# Usar a Claude para classificar + responder (1) ou o classificador offline (0)
USE_LLM=0
ANTHROPIC_API_KEY=sk-ant-...        # só é preciso com USE_LLM=1

# --- Dashboard ---------------------------------------------------------
# Assina o cookie de sessão. Sem isto, cada reinício fecha as sessões.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# URL público da aplicação — usado nos links de verificação/recuperação de
# email e para ativar cookies Secure. Ex.: https://gestor.onrender.com
APP_BASE_URL=

# --- Email transacional (mailer.py) -----------------------------------
# SMTP de qualquer fornecedor (Brevo, Resend, Postmark, Amazon SES, Mailgun…).
# Sem SMTP_HOST, os links de verificação/recuperação vão para a consola.
# Testar:  python mailer.py o-teu-email@exemplo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gestor de Alojamento <ola@teudominio.pt>

# Porta do servidor local (5000 é usada pelo AirPlay Receiver no macOS)
PORT=5050

# Correr o scheduler de mensagens proativas numa thread do dashboard.
# Deixar vazio em produção (usar antes um cron a chamar `python scheduler.py`).
RUN_SCHEDULER=

# --- Twilio (webhook.py + envio a prestadores) --------------------------
# Só TWILIO_AUTH_TOKEN: o webhook valida a assinatura dos pedidos recebidos.
# Os três: notifications.py envia WhatsApp real a prestadores e hóspedes.
# (nenhum definido: o envio é simulado para a consola)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Stripe (billing.py) ----------------------------------------------
# Sem STRIPE_SECRET_KEY, a Faturação usa o fluxo "pedir plano → admin aplica".
# Criar os preços:  python billing.py setup   (imprime os price IDs)
# Webhook do Stripe -> https://<host>/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INICIAL=
STRIPE_PRICE_INTERMEDIO=
STRIPE_PRICE_PRO=
